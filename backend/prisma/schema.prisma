generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  image
  file
}

enum StorageObjectStatus {
  pending_upload
  ready
  failed
}

enum FindingReviewDecision {
  accepted
  dismissed
  resolved
  deferred
}

enum ReportSourceKind {
  attachment
  local_code
  mcp
  reference
}

model Organization {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("organization_id") @db.Uuid
  publicNumber Int       @unique(map: "organization_public_number_key") @default(autoincrement()) @map("public_number")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  projects     Project[]
  users        User[]

  @@map("organization")
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  publicNumber   Int             @unique(map: "user_public_number_key") @default(autoincrement()) @map("public_number")
  organizationId String          @unique @map("organization_id") @db.Uuid
  username       String          @unique
  passwordHash   String          @map("password_hash")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewReports  ReviewReport[]
  features       Feature[]
  findingReviews FindingReview[]
  storageObjects StorageObject[]

  @@map("user")
}

model Project {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @map("project_id") @db.Uuid
  publicNumber   Int          @unique(map: "project_public_number_key") @default(autoincrement()) @map("public_number")
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  features       Feature[]

  @@index([organizationId])
  @@map("project")
}

model Feature {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("feature_id") @db.Uuid
  publicNumber Int       @unique(map: "feature_public_number_key") @default(autoincrement()) @map("public_number")
  projectId    String    @map("project_id") @db.Uuid
  title        String
  createdById  String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  reviewReports  ReviewReport[]
  storageObjects StorageObject[]

  @@unique([id, projectId], map: "feature_id_project_id_key")
  @@index([projectId])
  @@index([createdById])
  @@map("feature")
}

model StorageObject {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @map("storage_object_id") @db.Uuid
  publicNumber     Int                 @unique(map: "storage_object_public_number_key") @default(autoincrement()) @map("public_number")
  featureId        String              @map("feature_id") @db.Uuid
  createdById      String              @map("created_by") @db.Uuid
  status           StorageObjectStatus @default(pending_upload)
  uploadKey        String              @unique @map("upload_key")
  uploadVersionId  String?             @map("upload_version_id")
  s3Key            String              @unique @map("s3_key")
  s3VersionId      String?             @map("s3_version_id")
  etag             String?
  assetType        AssetType           @map("asset_type")
  mimeType         String              @map("mime_type")
  sizeBytes        BigInt              @map("size_bytes")
  originalFilename String              @map("original_filename")
  checksumSha256   String              @map("checksum_sha256")
  failureCode      String?             @map("failure_code")
  failureMessage   String?             @map("failure_message")
  uploadExpiresAt  DateTime            @map("upload_expires_at") @db.Timestamptz(6)
  confirmedAt      DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  readyAt          DateTime?           @map("ready_at") @db.Timestamptz(6)
  failedAt         DateTime?           @map("failed_at") @db.Timestamptz(6)
  firstUsedAt      DateTime?           @map("first_used_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  feature     Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  attachments ReportAttachment[]

  @@unique([id, featureId])
  @@index([featureId])
  @@index([status, uploadExpiresAt], map: "storage_object_status_upload_expiry_idx")
  @@index([status, failedAt])
  @@index([createdById])
  @@map("storage_object")
}

/// Immutable report produced outside the backend; no execution lifecycle.
model ReviewReport {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @map("review_report_id") @db.Uuid
  publicNumber  Int                @unique @default(autoincrement()) @map("public_number")
  featureId     String             @map("feature_id") @db.Uuid
  content       String
  formatVersion String             @map("format_version")
  savedById     String             @map("saved_by") @db.Uuid
  producedAt    DateTime           @map("produced_at") @db.Timestamptz(6)
  savedAt       DateTime           @default(now()) @map("saved_at") @db.Timestamptz(6)
  feature       Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  savedBy       User               @relation(fields: [savedById], references: [id], onDelete: Restrict)
  findings      ReviewFinding[]
  sources       ReportSource[]
  attachments   ReportAttachment[]

  @@unique([id, featureId])
  @@index([featureId, savedAt])
  @@index([savedById])
  @@map("review_report")
}

/// Assertions and producer-supplied verification metadata are immutable.
model ReviewFinding {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @map("review_finding_id") @db.Uuid
  publicNumber         Int               @unique @default(autoincrement()) @map("public_number")
  reportId             String            @map("report_id") @db.Uuid
  position             Int
  title                String
  description          String
  whyItMatters         String            @map("why_it_matters")
  category             String
  severity             String
  suggestedResolutions Json              @map("suggested_resolutions")
  verificationMetadata Json?             @map("verification_metadata")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  report               ReviewReport      @relation(fields: [reportId], references: [id], onDelete: Restrict)
  evidence             FindingEvidence[]
  reviews              FindingReview[]

  @@unique([id, reportId])
  @@unique([reportId, position])
  @@map("review_finding")
}

/// A report can reference only originals owned by its feature.
model ReportAttachment {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @map("report_attachment_id") @db.Uuid
  publicNumber    Int            @unique @default(autoincrement()) @map("public_number")
  reportId        String         @map("report_id") @db.Uuid
  featureId       String         @map("feature_id") @db.Uuid
  storageObjectId String         @map("storage_object_id") @db.Uuid
  report          ReviewReport   @relation(fields: [reportId, featureId], references: [id, featureId], onDelete: Restrict)
  storageObject   StorageObject  @relation(fields: [storageObjectId, featureId], references: [id, featureId], onDelete: Restrict)
  sources         ReportSource[]

  @@unique([id, reportId])
  @@unique([reportId, storageObjectId])
  @@index([storageObjectId, featureId])
  @@map("report_attachment")
}

/// Sources belong to one report. MCP sources store references, never copied content.
model ReportSource {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @map("report_source_id") @db.Uuid
  publicNumber Int               @unique @default(autoincrement()) @map("public_number")
  reportId     String            @map("report_id") @db.Uuid
  kind         ReportSourceKind
  title        String
  reference    String?
  relativePath String?           @map("relative_path")
  excerpt      String?
  revision     String?
  attachmentId String?           @map("attachment_id") @db.Uuid
  report       ReviewReport      @relation(fields: [reportId], references: [id], onDelete: Restrict)
  attachment   ReportAttachment? @relation(fields: [attachmentId, reportId], references: [id, reportId], onDelete: Restrict)
  evidence     FindingEvidence[]

  @@unique([id, reportId])
  @@index([reportId])
  @@index([attachmentId, reportId])
  @@map("report_source")
}

model FindingEvidence {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @map("finding_evidence_id") @db.Uuid
  publicNumber Int           @unique @default(autoincrement()) @map("public_number")
  reportId     String        @map("report_id") @db.Uuid
  findingId    String        @map("finding_id") @db.Uuid
  sourceId     String        @map("source_id") @db.Uuid
  locator      String?
  excerpt      String?
  finding      ReviewFinding @relation(fields: [findingId, reportId], references: [id, reportId], onDelete: Restrict)
  source       ReportSource  @relation(fields: [sourceId, reportId], references: [id, reportId], onDelete: Restrict)

  @@index([findingId, reportId])
  @@index([sourceId, reportId])
  @@map("finding_evidence")
}

/// Append-only. Current disposition orders by createdAt, then publicNumber.
model FindingReview {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @map("finding_review_id") @db.Uuid
  publicNumber Int                   @unique @default(autoincrement()) @map("public_number")
  findingId    String                @map("finding_id") @db.Uuid
  decision     FindingReviewDecision
  reason       String?
  createdById  String                @map("created_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  finding      ReviewFinding         @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@index([findingId, createdAt, publicNumber])
  @@index([createdById])
  @@map("finding_review")
}
